{
  "info": {
    "name": "Wiki API",
    "description": "FastAPI 기반 위키 시스템 API 컬렉션\n\n## 사용 순서\n1. Auth > Register 로 회원가입\n2. Auth > Login 으로 로그인 → access_token 자동 저장\n3. 이후 모든 요청에 토큰 자동 적용",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "회원가입",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "새 계정을 생성합니다.\n\n- username: 3~50자\n- email: 이메일 형식\n- password: 8자 이상"
          },
          "response": []
        },
        {
          "name": "로그인",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    console.log('토큰 저장 완료');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "testuser", "type": "text" },
                { "key": "password", "value": "password123", "type": "text" }
              ]
            },
            "description": "로그인 후 JWT 토큰을 발급받습니다.\n\n로그인 성공 시 access_token이 컬렉션 변수에 자동 저장되어 이후 요청에 자동 적용됩니다."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "내 정보 조회",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            },
            "description": "현재 로그인한 유저의 정보를 조회합니다."
          },
          "response": []
        },
        {
          "name": "내 정보 수정",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newemail@example.com\",\n  \"password\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "이메일 또는 비밀번호를 수정합니다. 변경할 항목만 포함하면 됩니다."
          },
          "response": []
        },
        {
          "name": "특정 유저 조회",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/1",
              "host": ["{{base_url}}"],
              "path": ["users", "1"]
            },
            "description": "user_id로 특정 유저 정보를 조회합니다."
          },
          "response": []
        },
        {
          "name": "전체 유저 목록 (관리자 전용)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["users", ""],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "전체 유저 목록을 조회합니다. is_admin이 true인 계정만 호출 가능합니다."
          },
          "response": []
        },
        {
          "name": "계정 탈퇴",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/users/1",
              "host": ["{{base_url}}"],
              "path": ["users", "1"]
            },
            "description": "계정을 비활성화합니다 (soft delete). 본인 또는 관리자만 가능합니다."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pages",
      "item": [
        {
          "name": "페이지 목록 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pages/?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["pages", ""],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "전체 페이지 목록을 조회합니다. 인증 없이 호출 가능합니다."
          },
          "response": []
        },
        {
          "name": "페이지 작성",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/pages/",
              "host": ["{{base_url}}"],
              "path": ["pages", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"파이썬이란\",\n  \"content\": \"파이썬은 인터프리터 방식의 프로그래밍 언어입니다.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "새 위키 페이지를 작성합니다.\n\n- title은 중복 불가\n- 로그인 필요"
          },
          "response": []
        },
        {
          "name": "페이지 상세 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pages/1",
              "host": ["{{base_url}}"],
              "path": ["pages", "1"]
            },
            "description": "page_id로 특정 페이지의 전체 내용을 조회합니다. 인증 없이 호출 가능합니다."
          },
          "response": []
        },
        {
          "name": "페이지 수정",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/pages/1",
              "host": ["{{base_url}}"],
              "path": ["pages", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"파이썬이란 (수정)\",\n  \"content\": \"파이썬은 간결한 문법이 특징인 프로그래밍 언어입니다.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "페이지를 수정합니다.\n\n수정 전 내용이 Archive에 자동 저장되고, version이 1 증가합니다.\n변경할 항목만 포함하면 됩니다."
          },
          "response": []
        },
        {
          "name": "페이지 삭제",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/pages/1",
              "host": ["{{base_url}}"],
              "path": ["pages", "1"]
            },
            "description": "페이지를 삭제합니다 (soft delete). 작성자 또는 관리자만 가능합니다."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Archives",
      "item": [
        {
          "name": "페이지 수정 이력 목록",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pages/1/archives/?skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["pages", "1", "archives", ""],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "특정 페이지의 수정 이력 목록을 최신순으로 조회합니다."
          },
          "response": []
        },
        {
          "name": "특정 버전 상세 조회",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pages/1/archives/1",
              "host": ["{{base_url}}"],
              "path": ["pages", "1", "archives", "1"]
            },
            "description": "특정 아카이브 버전의 전체 내용(제목, 본문)을 조회합니다."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "서버 상태 확인",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "서버가 정상 동작 중인지 확인합니다."
          },
          "response": []
        }
      ]
    }
  ]
}
